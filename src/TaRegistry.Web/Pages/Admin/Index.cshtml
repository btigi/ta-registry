@page "/admin"
@model TaRegistry.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>@Model.Name</h1>
<p class="lede">@Model.RegistryId · <a href="/registry.yaml">registry.yaml</a></p>

@if (Model.Dirty)
{
    <p class="banner warn">The catalogue has unpublished changes. <a asp-page="/Admin/Publish">Publish</a> before the game sees them.</p>
}

<div class="stats">
    <div class="stat"><b>@Model.PackageCount</b> packages</div>
    <div class="stat"><b>@Model.Sequence</b> sequence</div>
    <div class="stat"><b>@Model.Expires</b> expires</div>
</div>

<h2>Recent downloads</h2>
@if (Model.Recent.Count == 0)
{
    <p class="muted">No download keys yet.</p>
}
else
{
    <table>
        <thead>
            <tr><th>When</th><th>Package</th><th>Keys</th><th>Result</th></tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Recent)
        {
            <tr>
                <td class="mono">@row.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@row.Kind @row.PackageId <span class="muted">r@row.Release</span></td>
                <td>@row.KeyCount</td>
                <td>@(row.Result ?? "open")</td>
            </tr>
        }
        </tbody>
    </table>
}
