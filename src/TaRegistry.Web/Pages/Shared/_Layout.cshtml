<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · OA Registry</title>
    <link rel="stylesheet" href="~/site.css" />
</head>
<body>
    <header class="top">
        <a class="brand" href="/">OA Registry</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav>
                <a asp-page="/Admin/Index">Dashboard</a>
                <a asp-page="/Admin/Packages/Index">Packages</a>
                <a asp-page="/Admin/Publish">Publish</a>
                <a asp-page="/Admin/Keys">Keys</a>
                <a asp-page="/Admin/Settings">Settings</a>
            </nav>
            <form method="post" asp-page="/Admin/Logout">
                <button type="submit" class="text">Log out</button>
            </form>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
